# ---------------------------------------------------------------------------
# DETAILFLOW environment. Copy to .env (never commit real values).
# Local defaults are baked into scripts/local/stack.sh and the dev gateway.
# ---------------------------------------------------------------------------

# --- Web app (Vite, Cloudflare Pages build env) ---------------------------
# Supabase project URL. Local: the dev gateway.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable (anon) key. Hosted gateway requires it; local ignores it.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Edge Functions (Supabase secrets: `supabase secrets set ...`) --------
# SUPABASE_URL and SUPABASE_DB_URL are injected by the Supabase runtime.
# HMAC secret for customer manage links (32+ random bytes). Rotating it invalidates existing links.
DF_MANAGE_TOKEN_SECRET=
# Comma-separated origins allowed by CORS, e.g. https://app.detailflow.ru
DF_ALLOWED_ORIGINS=
# Public app URL used in notification links.
DF_APP_URL=https://app.example.ru
# Shared secret the scheduler sends to notify-dispatcher (x-dispatcher-secret).
DF_DISPATCHER_SECRET=
# Telegram bot token from @BotFather. Empty => notifications are marked not_configured.
TELEGRAM_BOT_TOKEN=
# LLM for the assistant. Empty => assistant reports unavailable; booking is unaffected.
ANTHROPIC_API_KEY=
DF_AI_MODEL=claude-sonnet-5-5
# Local only: HS256 secret of the local Supabase Auth. Hosted uses JWKS instead.
DF_JWT_SECRET=

# --- Scripts (seed / tenant pipeline) --------------------------------------
DATABASE_URL=postgres://postgres@127.0.0.1:54322/postgres_df
# Hosted: https://<ref>.supabase.co/auth/v1 ; local: GoTrue directly
AUTH_URL=http://127.0.0.1:54324
SUPABASE_SERVICE_ROLE_KEY=
# Initial password for demo owners created by the seed (local default: detailflow-demo)
DF_DEMO_OWNER_PASSWORD=
