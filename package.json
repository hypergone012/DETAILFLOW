{
  "name": "detailflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm tenant:assets && pnpm --filter @detailflow/web dev",
    "build": "pnpm tenant:assets && pnpm --filter @detailflow/web build",
    "typecheck": "tsc -p packages/domain && tsc -p packages/config && tsc -p apps/web && tsc -p tests",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "stack": "scripts/local/stack.sh",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:reset": "scripts/local/stack.sh reset && tsx scripts/db/migrate.ts",
    "tenant:seed": "tsx scripts/tenant/seed.ts",
    "tenant:assets": "tsx scripts/tenant/sync-assets.ts",
    "tenant:schema": "tsx scripts/tenant/schema.ts",
    "tenant:demo-art": "tsx scripts/tenant/demo-art.ts",
    "functions:serve": "pnpm -s functions:vendor && deno run --allow-net --allow-env --allow-read --config supabase/functions/deno.json supabase/functions/_dev/gateway.ts",
    "functions:check": "pnpm -s functions:vendor && deno check --config supabase/functions/deno.json supabase/functions/public-api/index.ts supabase/functions/owner-api/index.ts supabase/functions/notify-dispatcher/index.ts supabase/functions/assistant/index.ts supabase/functions/_dev/gateway.ts",
    "tenant": "tsx scripts/tenant/cli.ts",
    "tenant:icons": "tsx scripts/tenant/icons.ts",
    "security:scan-bundle": "tsx scripts/security/scan-bundle.ts",
    "build:prod": "DF_REQUIRE_HTTPS_API=1 pnpm build && pnpm security:scan-bundle",
    "test:pages": "playwright test -c playwright.pages.config.ts",
    "functions:vendor": "tsx scripts/prod/vendor-domain.ts",
    "prod:verify-db": "tsx scripts/prod/verify-db.ts",
    "prod:telegram-check": "tsx scripts/prod/telegram-check.ts",
    "prod:ai-smoke": "tsx scripts/prod/ai-smoke.ts",
    "test:prod": "playwright test -c playwright.prod.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@axe-core/playwright": "4.13.0",
    "@detailflow/config": "workspace:*",
    "@detailflow/domain": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.3",
    "deno": "2.9.6",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wrangler": "4.143.1",
    "zod": "4.6.5"
  }
}
